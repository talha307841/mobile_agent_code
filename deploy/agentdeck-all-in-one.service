[Unit]
Description=AgentDeck relay, public tunnel, and laptop agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/lib/agentdeck/run-managed-relay.sh
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
UMask=0077

[Install]
WantedBy=default.target
